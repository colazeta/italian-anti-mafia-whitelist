{
  "schema_version": 1,
  "repository_visibility": "public",
  "rule": "Every GitHub Actions artifact is a publication surface. Only explicitly classified public outputs may be uploaded.",
  "upload_artifacts": [
    {
      "workflow": ".github/workflows/anncsu-national-validation.yml",
      "name": "national-anncsu-verification-${{ github.run_attempt }}",
      "path": "artifacts/public-actions/national-anncsu/",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/cosenza-address-validation.yml",
      "name": "cosenza-address-validation-verification-${{ github.run_attempt }}",
      "path": "artifacts/public-actions/cosenza-address-validation/",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/cosenza-content-capture.yml",
      "name": "cosenza-content-verification-${{ github.run_attempt }}",
      "path": "artifacts/public-actions/cosenza-content-capture/",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/cosenza-snapshot-discovery.yml",
      "name": "cosenza-snapshot-discovery",
      "path": "cosenza-snapshot.csv",
      "classification": "deliberately_public_discovery"
    },
    {
      "workflow": ".github/workflows/discover-national-index.yml",
      "name": "national-white-list-index",
      "path": "national-white-list-index.csv",
      "classification": "deliberately_public_discovery"
    },
    {
      "workflow": ".github/workflows/evidence-recovery.yml",
      "name": "evidence-recovery-verification-${{ github.run_id }}-${{ github.run_attempt }}",
      "path": "/tmp/private-evidence-recovery/receipts/*.json",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/evidence-store.yml",
      "name": "evidence-store-verification-${{ github.run_id }}-${{ github.run_attempt }}",
      "path": "/tmp/private-evidence-check/*.verification.json",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/fallback-geocoding-validation.yml",
      "name": "fallback-geocoding-verification-${{ github.run_attempt }}",
      "path": "artifacts/public-actions/fallback-geocoding/",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/pistoia-address-replication.yml",
      "name": "pistoia-address-replication-verification-${{ github.run_attempt }}",
      "path": "artifacts/public-actions/pistoia-address-replication/",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/promote-frozen-release.yml",
      "name": "frozen-public-rendered-evidence-attempt-${{ github.run_attempt }}",
      "path": "test-results/",
      "classification": "deliberately_public_publication"
    },
    {
      "workflow": ".github/workflows/promote-frozen-release.yml",
      "name": "frozen-public-link-audit-attempt-${{ github.run_attempt }}",
      "path": "/tmp/public-link-audit.json",
      "classification": "deliberately_public_publication"
    },
    {
      "workflow": ".github/workflows/promote-frozen-release.yml",
      "name": "frozen-public-review-${{ steps.release.outputs.release_id }}-attempt-${{ github.run_attempt }}",
      "path": "public-site/",
      "classification": "deliberately_public_publication"
    },
    {
      "workflow": ".github/workflows/public-registry-review.yml",
      "name": "public-rendered-evidence-attempt-${{ github.run_attempt }}",
      "path": "test-results/",
      "classification": "deliberately_public_publication"
    },
    {
      "workflow": ".github/workflows/public-registry-review.yml",
      "name": "public-link-audit-attempt-${{ github.run_attempt }}",
      "path": "/tmp/public-link-audit.json",
      "classification": "deliberately_public_publication"
    },
    {
      "workflow": ".github/workflows/public-registry-review.yml",
      "name": "public-portal-review-attempt-${{ github.run_attempt }}",
      "path": "public-site/",
      "classification": "deliberately_public_publication"
    },
    {
      "workflow": ".github/workflows/public-pages.yml",
      "name": "public-snapshot-browser-${{ github.run_attempt }}",
      "path": "test-results/",
      "classification": "deliberately_public_publication"
    },
    {
      "workflow": ".github/workflows/archive-reviewed-sources.yml",
      "name": "reviewed-source-captures-${{ github.run_id }}-${{ github.run_attempt }}",
      "path": "/tmp/public-actions/reviewed-source-captures.json",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/research-performance-pilot.yml",
      "name": "research-performance-aggregate-${{ github.run_id }}",
      "path": "artifacts/public-actions/research-performance/",
      "classification": "public_operational_verification",
      "scope": "Only research/white-list-performance-pilot branch; never deployed to the public portal",
      "content_boundary": "Non-identifying aggregate diagnostics, source hashes and official source URLs, discovery eligibility, synthetic-test receipts and already-public research code. No company-level records, source documents or canonical database exports. Experimental diagnostics are not validated administrative-performance estimates."
    },
    {
      "workflow": ".github/workflows/prefecture-robots.yml",
      "name": "robot-report-${{ matrix.shard }}",
      "path": "/tmp/public-actions/robot-report/report.json",
      "classification": "public_operational_verification"
    },
    {
      "workflow": ".github/workflows/transform-reviewed-captures.yml",
      "name": "white-list-candidate-extract-status-${{ matrix.shard }}-${{ github.run_id }}",
      "path": "/tmp/public-actions/white-list-candidate-extract/summary.json",
      "classification": "public_operational_verification",
      "scope": "Unapproved private candidate extraction: aggregate verification only; full rows retained exclusively in protected object storage",
      "content_boundary": "Closed totals-only fields: shard, candidate/extracted/reused/quarantined/blocked/deferred counts, QA-flag totals, exact private readback count and zero public promotions. No candidate URLs, source identities, companies, identifiers, hashes, archive storage keys or source row data."
    },
    {
      "workflow": ".github/workflows/transform-reviewed-captures.yml",
      "name": "white-list-transform-status-${{ matrix.shard }}-${{ github.run_id }}",
      "path": "/tmp/public-actions/white-list-auto-transform/summary.json",
      "classification": "public_operational_verification",
      "scope": "Private transformer public verification only; source data and private QA remain off Actions artifacts",
      "content_boundary": "Closed totals-only report: run time, shard, changed/parsed/reused/quarantined/blocked/deferred counts, QA-flag totals, verified database readback counts and zero public promotions. No source keys, companies, records, documents, capture identities, hashes, private storage or database coordinates."
    }
  ],
  "pages_artifacts": [
    {
      "workflow": ".github/workflows/public-pages.yml",
      "path": "public-site",
      "classification": "deliberately_public_publication"
    }
  ],
  "release_assets": [
    {
      "workflow": ".github/workflows/public-registry-review.yml",
      "tag": "public-data-${{ github.run_id }}-${{ github.run_attempt }}",
      "path": "/tmp/public-registry-release/",
      "classification": "deliberately_public_publication"
    }
  ]
}
